{
  "manifest_version": 3,
  "name": "車検予約自動化ツール V2",
  "version": "2.0",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["*://ams-yoyaku.jp/*", "*://*.ams-yoyaku.jp/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}